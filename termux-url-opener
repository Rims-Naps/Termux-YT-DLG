#!/data/data/com.termux/files/usr/bin/bash

BASE_DIR="$HOME/storage/shared"
AUDIO_DIR="$BASE_DIR/Music/New"
VIDEO_DIR="$BASE_DIR/Movies/New"
TMP_DIR="$BASE_DIR/.termux-yt-dlg/tmp"
STATE_DIR="$BASE_DIR/.termux-yt-dlg/state"
ARCHIVE_FILE="$STATE_DIR/download-archive.txt"
LOG_DIR="$BASE_DIR/.termux-yt-dlg/logs"
SUCCESS_LOG="$LOG_DIR/success.log"
ERROR_LOG="$LOG_DIR/error.log"
COMMAND_LOG="$LOG_DIR/command-history.log"
LOG_MAX_BYTES=$((512 * 1024))

COOKIE_CANDIDATES=(
    "$HOME/.config/yt-dlp/cookies.txt"
    "$BASE_DIR/cookies.txt"
)

for directory in "$AUDIO_DIR" "$VIDEO_DIR" "$TMP_DIR" "$STATE_DIR" "$LOG_DIR"; do
    mkdir -p -- "$directory" 2>/dev/null || exit 1
done
for log_file in "$SUCCESS_LOG" "$ERROR_LOG" "$COMMAND_LOG"; do
    [[ -f "$log_file" ]] || : > "$log_file"
done

cap_log() {
    local file="$1" size temporary
    size=$(wc -c < "$file" 2>/dev/null || echo 0)
    if (( size > LOG_MAX_BYTES )); then
        temporary="${file}.tmp.$$"
        tail -c "$LOG_MAX_BYTES" -- "$file" > "$temporary" 2>/dev/null && mv -f -- "$temporary" "$file"
        rm -f -- "$temporary" 2>/dev/null
    fi
}
for log_file in "$SUCCESS_LOG" "$ERROR_LOG" "$COMMAND_LOG"; do
    cap_log "$log_file"
done

log_success() { printf '[%s] %s\n' "$(date +'%Y-%m-%d %H:%M:%S')" "$*" >> "$SUCCESS_LOG"; }
log_error() { printf '[%s] %s\n' "$(date +'%Y-%m-%d %H:%M:%S')" "$*" >> "$ERROR_LOG"; }
log_info() { printf '[%s] %s\n' "$(date +'%Y-%m-%d %H:%M:%S')" "$*" >> "$COMMAND_LOG"; }

NOTIFY_ID="ytdlg_$$"
HAVE_NOTIFY=false
HAVE_TOAST=false
command -v termux-notification >/dev/null 2>&1 && HAVE_NOTIFY=true
command -v termux-toast >/dev/null 2>&1 && HAVE_TOAST=true

notify_stage() {
    local message="$1"
    if $HAVE_NOTIFY; then
        termux-notification --id "$NOTIFY_ID" --title "Termux-YT-DLG" --content "$message" --priority low --ongoing 2>/dev/null
    fi
}

notify_final() {
    local title="$1" message="$2" success="$3"
    if $HAVE_NOTIFY; then
        if [[ "$success" == true ]]; then
            termux-notification --id "$NOTIFY_ID" --title "$title" --content "$message" --priority default 2>/dev/null
        else
            termux-notification --id "$NOTIFY_ID" --title "$title" --content "$message" --priority high 2>/dev/null
        fi
    fi
    $HAVE_TOAST && termux-toast -g middle -s "$message" 2>/dev/null
}

url="${1:-}"
if [[ -z "$url" ]]; then
    log_error "No URL provided. Exiting."
    exit 1
fi

urldecode() {
    local encoded="${1//+/ }"
    printf '%b' "${encoded//%/\\x}"
}

unwrap_google_redirect() {
    local input="$1" encoded
    if [[ "$input" == *"google."*"/url?"* ]]; then
        encoded=$(printf '%s' "$input" | sed -n 's/.*[?&]\(url\|q\)=\([^&]*\).*/\2/p')
        [[ -n "$encoded" ]] && urldecode "$encoded" && return 0
    fi
    printf '%s' "$input"
}

unwrapped_url=$(unwrap_google_redirect "$url")
if [[ "$unwrapped_url" != "$url" && -n "$unwrapped_url" ]]; then
    log_info "Unwrapped Google redirect: $url -> $unwrapped_url"
    url="$unwrapped_url"
fi

{
    printf -- '----------------------------------------\n'
    printf '[%s] PID:%s\n' "$(date +'%Y-%m-%d %H:%M:%S')" "$$"
    printf '%s' "$0"
    for argument in "$@"; do printf ' %q' "$argument"; done
    printf '\n----------------------------------------\n'
} >> "$COMMAND_LOG" 2>/dev/null

COOKIE_ARGS=()
for cookie_file in "${COOKIE_CANDIDATES[@]}"; do
    if [[ -s "$cookie_file" ]]; then
        COOKIE_ARGS=(--cookies "$cookie_file")
        log_info "Using cookie file: $cookie_file"
        break
    fi
done

DOWNLOADER_ARGS=()
if command -v aria2c >/dev/null 2>&1; then
    DOWNLOADER_ARGS=(--downloader aria2c --downloader-args 'aria2c:-x 16 -s 16 -j 16 -k 1M')
else
    log_info "aria2c not found - using yt-dlp's native downloader."
fi

EMBED_ARGS=(--embed-metadata --embed-chapters --embed-thumbnail --add-metadata)
notify_stage "Queued - detecting content type..."

move_completed_files() {
    local source="$1" moved=0 file
    for file in "$source"/*; do
        [[ -e "$file" ]] || continue
        case "$file" in *.part|*.ytdl|*.part-Frag*|*.temp) continue ;; esac
        case "$file" in
            *.mp3|*.m4a|*.opus|*.aac|*.flac|*.wav|*.ogg) mv -f -- "$file" "$AUDIO_DIR/" && moved=$((moved + 1)) ;;
            *) mv -f -- "$file" "$VIDEO_DIR/" && moved=$((moved + 1)) ;;
        esac
    done
    printf '%s\n' "$moved"
}

cleanup_tmp() {
    local directory="$1" file
    for file in "$directory"/*; do
        [[ -e "$file" ]] || continue
        case "$file" in *.part|*.ytdl|*.part-Frag*|*.temp) rm -f -- "$file" ;; esac
    done
    rmdir -- "$directory" 2>/dev/null || log_error "$directory | Temporary directory retained because it is not empty"
}

{
    content_type="generic"
    playlist_info=""
    format="best"
    post_args=()
    extractor_args=()
    playlist_args=()
    header_args=()
    is_youtube=false
    is_playlist=false

    if [[ "$url" == *youtube.com* || "$url" == *youtu.be* ]]; then
        is_youtube=true
        if [[ "$url" == *"youtube.com/playlist?"* || "$url" == *"youtube.com/playlist&"* || "$url" == *"music.youtube.com/playlist?"* || "$url" == *"music.youtube.com/playlist&"* ]]; then
            is_playlist=true
        elif [[ "$url" == *"youtube.com/watch?"*list=* || "$url" == *"youtube.com/watch&"*list=* || "$url" == *"youtu.be/"*\?*list=* ]]; then
            is_playlist=true
        fi
    fi

    if [[ "$is_youtube" == true && "$url" == *music.youtube.com* ]]; then
        content_type="music"
        format="bestaudio[ext=m4a]/bestaudio/best"
        post_args=(-x --audio-format mp3 --audio-quality 0)
        extractor_args=(--extractor-args "youtube:player_client=android,web")
    elif [[ "$is_playlist" == true ]]; then
        content_type="music"
        playlist_info=" (Playlist)"
        format="bestaudio[ext=m4a]/bestaudio/best"
        post_args=(-x --audio-format mp3 --audio-quality 0)
        extractor_args=(--extractor-args "youtube:player_client=android,web")
        playlist_args=(--yes-playlist)
    elif [[ "$is_youtube" == true && ( "$url" == *"youtube.com/watch"* || "$url" == *"youtu.be/"* ) ]]; then
        content_type="video"
        format="bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080][ext=mp4]/best"
        extractor_args=(--extractor-args "youtube:player_client=android,web")
    elif [[ "$url" == *pornhub* || "$url" == *xvideos* || "$url" == *xnxx* ]]; then
        header_args=(--add-header "Referer:https://www.google.com/")
    fi

    notify_stage "Detected: ${content_type}${playlist_info} - starting download"
    download_directory="$TMP_DIR/$$_$(date +%s)"
    mkdir -p -- "$download_directory" || exit 1
    download_success=false
    exit_status=1

    for attempt in 1 2 3; do
        if [[ $attempt -eq 2 && ${#extractor_args[@]} -gt 0 ]]; then
            extractor_args=(--extractor-args "youtube:player_client=tv_embedded,web")
        fi
        notify_stage "Downloading (attempt ${attempt}/3)..."
        stderr_file="$download_directory/.yt-dlp-${attempt}.stderr"
        yt-dlp \
            "${header_args[@]}" "${COOKIE_ARGS[@]}" "${extractor_args[@]}" "${playlist_args[@]}" \
            "${DOWNLOADER_ARGS[@]}" -f "$format" "${post_args[@]}" "${EMBED_ARGS[@]}" \
            --download-archive "$ARCHIVE_FILE" --no-mtime \
            -o "$download_directory/%(title)s.%(ext)s" "$url" \
            > /dev/null 2> "$stderr_file"
        exit_status=$?
        if [[ $exit_status -eq 0 ]]; then
            download_success=true
            rm -f -- "$stderr_file"
            break
        fi
        log_error "$url | Type: $content_type$playlist_info | Attempt $attempt failed | Exit status: $exit_status"
        if [[ -s "$stderr_file" ]]; then
            { echo "---- yt-dlp stderr (attempt $attempt) ----"; cat -- "$stderr_file"; echo "-------------------------------------------"; } >> "$ERROR_LOG"
        fi
        rm -f -- "$stderr_file"
        [[ $attempt -lt 3 ]] && notify_stage "Attempt ${attempt}/3 failed - retrying..." && sleep 5
done

    if [[ "$download_success" == true ]]; then
        notify_stage "Finalizing - moving files and scanning media..."
        moved=$(move_completed_files "$download_directory")
        log_success "$url | Type: $content_type$playlist_info | Attempt: $attempt | Files: $moved"
        cleanup_tmp "$download_directory"
        if command -v termux-media-scan >/dev/null 2>&1; then
            termux-media-scan "$AUDIO_DIR" "$VIDEO_DIR" 2>/dev/null
        fi
        notify_final "Download complete" "$moved file(s) saved (${content_type}${playlist_info})." true
    else
        log_error "$url | Type: $content_type$playlist_info | Download failed after 3 attempts | Exit status: $exit_status | Partial files: $download_directory"
        notify_final "Download failed" "${content_type}${playlist_info} failed after 3 attempts. See error log." false
    fi
} &

am start -n "$(am get-activity | cut -d '/' -f1)" >/dev/null 2>&1
exit 0
