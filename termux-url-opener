#!/data/data/com.termux/files/usr/bin/bash



DOWNLOAD_DIR="/data/data/com.termux/files/home/storage/shared/New"
LOG_FILE="/data/data/com.termux/files/home/storage/shared/yt_dlp_log.txt"


# Ensure download directory and log file exist
[[ -d "$DOWNLOAD_DIR" ]] || mkdir -p "$DOWNLOAD_DIR"
[[ -f "$LOG_FILE" ]]     || touch "$LOG_FILE"
# Rotate log if >100KB
if [[ $(wc -c < "$LOG_FILE") -gt 102400 ]]; then
    tail -n 500 "$LOG_FILE" > "${LOG_FILE}.tmp" && mv "${LOG_FILE}.tmp" "$LOG_FILE"
fi

url="$1"
if [[ -z "$url" ]]; then
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] ERROR: No URL provided. Exiting." >> "$LOG_FILE"
    exit 1
fi

# Validate input URL
url="$1"
if [[ -z "$url" ]]; then
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] ERROR: No URL provided. Exiting." >> "$LOG_FILE"
    exit 1
fi

echo "[$(date +'%Y-%m-%d %H:%M:%S')] Starting background download: $url" >> "$LOG_FILE"

{

    # Classify URL and set yt-dlp args
    content_type="unknown"
    playlist_info=""
    download_success=false
    BYPASS_ARGS=( --geo-bypass --age-limit 99 )
    HEADER_ARGS=( --user-agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36" )
    COOKIE_ARGS=()
    FORMAT=""
    POST_ARGS=()
    EXTRACTOR_ARGS=()
    PLAYLIST_ARGS=()
    is_playlist=false
    if [[ "$url" == *"playlist"* || "$url" == *"list="* ]]; then
        is_playlist=true
    fi
    if [[ "$url" == *"music.youtube.com"* ]] || [[ "$is_playlist" == true ]]; then
        content_type="music"
        FORMAT="bestaudio[ext=m4a]/bestaudio/best"
        POST_ARGS=( -x --audio-format mp3 --audio-quality 0 )
        EXTRACTOR_ARGS=( --extractor-args "youtube:player_client=android,web" )
        if [[ "$is_playlist" == true ]]; then
            playlist_info=" (Playlist)"
            PLAYLIST_ARGS=( --yes-playlist )
        fi
    elif [[ "$url" == *"youtube.com/watch"* || "$url" == *"youtu.be"* ]]; then
        content_type="video"
        FORMAT="bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080][ext=mp4]/best"
        EXTRACTOR_ARGS=( --extractor-args "youtube:player_client=android,web" )
    else
        content_type="generic"
        FORMAT="best"
        if [[ "$url" == *"pornhub"* || "$url" == *"xvideos"* || "$url" == *"xnxx"* ]]; then
            echo "[$(date +'%Y-%m-%d %H:%M:%S')] Detected adult site — applying geo-bypass and Referer header" >> "$LOG_FILE"
            HEADER_ARGS+=( --add-header "Referer:https://www.google.com/" )
        fi
    fi
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] Processing: $url | Type: $content_type$playlist_info" >> "$LOG_FILE"
    # Retry loop (3 attempts)
    for attempt in 1 2 3; do
        if [[ $attempt -eq 2 && ${#EXTRACTOR_ARGS[@]} -gt 0 ]]; then
            echo "[$(date +'%Y-%m-%d %H:%M:%S')] Attempt 2: switching to tv_embedded player client" >> "$LOG_FILE"
            EXTRACTOR_ARGS=( --extractor-args "youtube:player_client=tv_embedded,web" )
        fi
        if [[ $attempt -eq 3 ]]; then
            echo "[$(date +'%Y-%m-%d %H:%M:%S')] Attempt 3: falling back to auto-detection" >> "$LOG_FILE"
            EXTRACTOR_ARGS=()
            fallback_url="generic:$url"
        else
            fallback_url="$url"
        fi
        if yt-dlp \
            "${BYPASS_ARGS[@]}" \
            "${HEADER_ARGS[@]}" \
            "${COOKIE_ARGS[@]}" \
            "${EXTRACTOR_ARGS[@]}" \
            "${PLAYLIST_ARGS[@]}" \
            -f "$FORMAT" \
            "${POST_ARGS[@]}" \
            --no-warnings \
            --ignore-errors \
            -o "$DOWNLOAD_DIR/%(title)s.%(ext)s" \
            "$fallback_url" \
            2>> "$LOG_FILE"
        then
            download_success=true
            if [[ "$is_playlist" == true ]]; then
                file_count=$(find "$DOWNLOAD_DIR" \( -name "*.mp3" -o -name "*.mp4" -o -name "*.m4a" \) -newer "$LOG_FILE" | wc -l)
            else
                file_count=1
            fi
            echo "[$(date +'%Y-%m-%d %H:%M:%S')] Download succeeded on attempt $attempt | Files: $file_count" >> "$LOG_FILE"
            break
        else
            echo "[$(date +'%Y-%m-%d %H:%M:%S')] Download failed, attempt $attempt of 3." >> "$LOG_FILE"
            sleep 5
        fi
    done
    # Final status logging
    if [[ "$download_success" == false ]]; then
        echo "[$(date +'%Y-%m-%d %H:%M:%S')] Download failed after 3 attempts." >> "$LOG_FILE"
        echo "[$(date +'%Y-%m-%d %H:%M:%S')] Suggestion: Try a VPN, or export browser cookies and set COOKIE_ARGS." >> "$LOG_FILE"
    fi
    # Trigger Android media scan
    if command -v termux-media-scan >/dev/null 2>&1; then
        termux-media-scan "$DOWNLOAD_DIR" 2>/dev/null
        echo "[$(date +'%Y-%m-%d %H:%M:%S')] Media scan completed." >> "$LOG_FILE"
    fi
} &
# Android returns to the previous app automatically
exit 0
