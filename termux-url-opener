#!/data/data/com.termux/files/usr/bin/bash

# Notification actions do not inherit the interactive Termux PATH.
case ":$PATH:" in
    *":${BASH%/*}:"*) ;;
    *) export PATH="${BASH%/*}:$PATH" ;;
esac

# Only these two literal settings are accepted; configuration is never evaluated.
NOTIFICATIONS=true
RETRY_PROMPTS=true
while IFS='=' read -r key value || [[ -n $key ]]; do
    value=${value%$'\r'}
    case "$key=$value" in
        NOTIFICATIONS=true|NOTIFICATIONS=false) NOTIFICATIONS="$value" ;;
        RETRY_PROMPTS=true|RETRY_PROMPTS=false) RETRY_PROMPTS="$value" ;;
    esac
done < <(cat "$HOME/.config/termux-yt-dlg/config" 2>/dev/null)

STATE_DIR="$HOME/.local/state/termux-yt-dlg"
if ! { mkdir -p -- "$STATE_DIR" && chmod 700 "$STATE_DIR"; } 2>/dev/null; then
    NOTIFICATIONS=false
fi
SCRIPT_PATH="$(cd -- "$(dirname -- "$0")" && pwd)/$(basename -- "$0")"
# POSIX shell quoting: Termux:API feeds actions to dash, not bash.
shell_quote() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
api_call() {
    command -v "$1" >/dev/null 2>&1 || return 1
    timeout --kill-after=2 10 "$@" </dev/null >/dev/null 2>&1
}

# Atomic rename consumes a token once, even if Retry and Dismiss race.
if [[ ${1:-} == --notification-action ]]; then
    token=${3:-}
    [[ $token =~ ^[A-Za-z0-9]+$ && ( ${2:-} == retry || ${2:-} == dismiss ) ]] || exit 1
    claim="$STATE_DIR/$token.claim.$BASHPID"
    mv -- "$STATE_DIR/$token.url" "$claim" 2>/dev/null || exit 0
    # A sentinel preserves trailing newlines in the stored URL.
    url=$(cat -- "$claim"; printf '.')
    url=${url%.}
    rm -f -- "$claim"
    rm -f -- "$STATE_DIR/$token"
    api_call termux-notification-remove "ytdlg-$token"
    [[ $2 == retry ]] || exit 0
    # Explicit user action starts exactly one normal three-attempt sequence.
    set -- "$url"
fi

# --- Directories -----------------------------------------------------------
# Type-aware download routing. Files land directly in Music/Movies once
# finished, and interrupted/partial downloads never leave the tmp dir, so
# Android's media scanner only ever sees completed files.
BASE_DIR="$HOME/storage/shared"
AUDIO_DIR="$BASE_DIR/Music/New"
VIDEO_DIR="$BASE_DIR/Movies/New"
TMP_DIR="$BASE_DIR/.termux-yt-dlg/tmp"

# --- Logs --------------------------------------------------------------
LOG_DIR="$BASE_DIR/.termux-yt-dlg/logs"
SUCCESS_LOG="$LOG_DIR/success.log"
ERROR_LOG="$LOG_DIR/error.log"
COMMAND_LOG="$LOG_DIR/command-history.log"
FAILURE_DIR="$LOG_DIR/failed-downloads"

# Active files are never retention candidates. Serialize publication and cleanup
# with a kernel lock (released automatically even if this process is killed).
finish_error_log() {
    [[ -n ${detail_log:-} ]] || return 0
    python - "$FAILURE_DIR" "$detail_log" "$STATE_DIR/.retention.lock" <<'PY'
import os, pathlib, re, sys
folder, active, lock_path = map(pathlib.Path, sys.argv[1:])
# Keep advisory locks on Termux's private filesystem, not Android shared storage.
with lock_path.open('a+b') as lock:
    if os.name == 'nt':
        import msvcrt
        lock.write(b'0'); lock.flush(); lock.seek(0)
        msvcrt.locking(lock.fileno(), msvcrt.LK_LOCK, 1)
    else:
        import fcntl
        fcntl.flock(lock, fcntl.LOCK_EX)
    active.rename(active.with_suffix('.log'))
    logs = [p for p in folder.iterdir() if
            re.fullmatch(r'ytdlg-[A-Za-z0-9]+\.log', p.name)
            and p.is_file() and not p.is_symlink()]
    logs.sort(key=lambda p: (p.stat().st_mtime_ns, p.name))
    for p in logs[:-25]:
        p.unlink()
PY
}

notify_result() {
    [[ $NOTIFICATIONS == true ]] || return 0
    local args=(--id "ytdlg-$token" --title "$1" --content "$url | $2")
    if [[ $download_success == false && $RETRY_PROMPTS == true ]]; then
        (umask 077; printf '%s' "$url" > "$STATE_DIR/$token.url") || return 0
        local base="$(shell_quote "$BASH") $(shell_quote "$SCRIPT_PATH") --notification-action"
        args+=(--button1 Retry --button1-action "$base retry $token"
               --button2 Dismiss --button2-action "$base dismiss $token"
               --on-delete "$base dismiss $token")
    fi
    api_call termux-notification "${args[@]}" || rm -f -- "$STATE_DIR/$token.url"
}

# Ensure required directories exist. Never touches/truncates anything that
# already exists.
for _d in "$AUDIO_DIR" "$VIDEO_DIR" "$TMP_DIR" "$LOG_DIR"; do
    [[ -d "$_d" ]] || mkdir -p -- "$_d" 2>/dev/null
done

# Ensure log files exist (append-only; never truncated/rotated).
for _f in "$SUCCESS_LOG" "$ERROR_LOG" "$COMMAND_LOG"; do
    [[ -f "$_f" ]] || : >> "$_f" 2>/dev/null
done

log_success() { printf '[%s] %s\n' "$(date +'%Y-%m-%d %H:%M:%S')" "$*" >> "$SUCCESS_LOG"; }
log_error()   { printf '[%s] %s\n' "$(date +'%Y-%m-%d %H:%M:%S')" "$*" >> "$ERROR_LOG"; }

# Record the exact invocation (script + all args, quoted) before doing
# anything else, so every call to this tool is logged regardless of what
# happens afterward.
token=""
if [[ $NOTIFICATIONS == true ]]; then
    token=$(mktemp "$STATE_DIR/XXXXXXXXXXXX" 2>/dev/null) || NOTIFICATIONS=false
    token=${token##*/}
fi
detail_log=""
started=$(date -Iseconds)
{
    printf -- '----------------------------------------\n'
    printf '[%s] PID:%s\n' "$(date +'%Y-%m-%d %H:%M:%S')" "$$"
    printf '%s' "$0"
    for _arg in "$@"; do
        printf ' %q' "$_arg"
    done
    printf '\n'
    printf -- '----------------------------------------\n'
} >> "$COMMAND_LOG" 2>/dev/null

url="$1"
if [[ -z "$url" ]]; then
    log_error "No URL provided. Exiting."
    [[ -z $token ]] || rm -f -- "$STATE_DIR/$token"
    exit 1
fi

# Moves finished files out of a per-download temp dir into the correct
# type-based directory, based on file extension. Skips yt-dlp's own
# in-progress artifacts so partial files are never picked up. Prints the
# number of files moved.
move_completed_files() {
    local src="$1" moved=0 f
    for f in "$src"/*; do
        [[ -e "$f" ]] || continue
        case "$f" in
            *.part|*.ytdl|*.part-Frag*|*.temp) continue ;;
        esac
        case "$f" in
            *.mp3|*.m4a|*.opus|*.aac|*.flac|*.wav|*.ogg)
                mv -f -- "$f" "$AUDIO_DIR/" && moved=$((moved + 1)) ;;
            *)
                mv -f -- "$f" "$VIDEO_DIR/" && moved=$((moved + 1)) ;;
        esac
    done
    echo "$moved"
}

{
    content_type="unknown"
    playlist_info=""
    download_success=false
    exit_status=""
    BYPASS_ARGS=( --geo-bypass --age-limit 99 )
    HEADER_ARGS=( --user-agent "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36" )
    COOKIE_ARGS=()
    FORMAT=""
    POST_ARGS=()
    EXTRACTOR_ARGS=()
    PLAYLIST_ARGS=()
    is_playlist=false
    if [[ "$url" == *"playlist"* || "$url" == *"list="* ]]; then
        is_playlist=true
    fi

    # Classify URL and set yt-dlp args (unchanged from previous behavior).
    if [[ "$url" == *"music.youtube.com"* ]] || [[ "$is_playlist" == true ]]; then
        content_type="music"
        FORMAT="bestaudio[ext=m4a]/bestaudio/best"
        POST_ARGS=( -x --audio-format mp3 --audio-quality 0 )
        EXTRACTOR_ARGS=( --extractor-args "youtube:player_client=android,web" )
        if [[ "$is_playlist" == true ]]; then
            playlist_info=" (Playlist)"
            PLAYLIST_ARGS=( --yes-playlist )
        fi
    elif [[ "$url" == *"youtube.com/watch"* || "$url" == *"youtu.be"* ]]; then
        content_type="video"
        FORMAT="bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080][ext=mp4]/best"
        EXTRACTOR_ARGS=( --extractor-args "youtube:player_client=android,web" )
    else
        content_type="generic"
        FORMAT="best"
        if [[ "$url" == *"pornhub"* || "$url" == *"xvideos"* || "$url" == *"xnxx"* ]]; then
            HEADER_ARGS+=( --add-header "Referer:https://www.google.com/" )
        fi
    fi

    # Each invocation gets its own temp subdirectory so partial/interrupted
    # files from concurrent or retried downloads never mix, and are never
    # mistaken for completed downloads (they only leave this dir on success).
    dl_tmp="$TMP_DIR/$$_$(date +%s)"
    mkdir -p -- "$dl_tmp" 2>/dev/null
    if [[ ! -d "$dl_tmp" ]]; then
        log_error "$url | Could not create temp directory: $dl_tmp"
        [[ -z $token ]] || rm -f -- "$STATE_DIR/$token"
        exit 1
    fi

    # Retry loop (3 attempts) — unchanged strategy from previous behavior.
    for attempt in 1 2 3; do
        attempt_started=$(date -Iseconds)
        if [[ $attempt -eq 2 && ${#EXTRACTOR_ARGS[@]} -gt 0 ]]; then
            EXTRACTOR_ARGS=( --extractor-args "youtube:player_client=tv_embedded,web" )
        fi
        if [[ $attempt -eq 3 ]]; then
            EXTRACTOR_ARGS=()
            fallback_url="generic:$url"
        else
            fallback_url="$url"
        fi

        yt_stderr="$dl_tmp/.yt-dlp-attempt-${attempt}.stderr"
        yt-dlp \
            "${BYPASS_ARGS[@]}" \
            "${HEADER_ARGS[@]}" \
            "${COOKIE_ARGS[@]}" \
            "${EXTRACTOR_ARGS[@]}" \
            "${PLAYLIST_ARGS[@]}" \
            -f "$FORMAT" \
            "${POST_ARGS[@]}" \
            --no-warnings \
            --ignore-errors \
            -o "$dl_tmp/%(title)s.%(ext)s" \
            -- \
            "$fallback_url" \
            > /dev/null 2> "$yt_stderr"
        exit_status=$?

        if [[ $exit_status -ne 0 && -z $detail_log ]]; then
            mkdir -p -- "$FAILURE_DIR"
            detail_log=$(mktemp "$FAILURE_DIR/ytdlg-XXXXXXXXXXXX.active")
            if [[ -n $detail_log ]]; then
                printf 'URL: %s\nStarted: %s\n' "$url" "$started" >> "$detail_log"
            fi
        fi
        if [[ -n $detail_log ]]; then
            printf '[%s .. %s] Attempt %s | Exit status: %s\n' "$attempt_started" "$(date -Iseconds)" "$attempt" "$exit_status" >> "$detail_log"
            cat -- "$yt_stderr" >> "$detail_log"
        fi

        if [[ $exit_status -eq 0 ]]; then
            download_success=true
            rm -f -- "$yt_stderr"
            break
        else
            log_error "$url | Type: $content_type$playlist_info | Attempt $attempt failed | Exit status: $exit_status"
            if [[ -s "$yt_stderr" ]]; then
                {
                    echo "  ---- yt-dlp stderr (attempt $attempt) ----"
                    cat -- "$yt_stderr"
                    echo "  -------------------------------------------"
                } >> "$ERROR_LOG"
            fi
            rm -f -- "$yt_stderr"
            sleep 5
        fi
    done

    if [[ "$download_success" == true ]]; then
        moved=$(move_completed_files "$dl_tmp")
        log_success "$url | Type: $content_type$playlist_info | Attempt: $attempt | Files: $moved"
        # Clean up the temp subdir now that its contents have been moved out.
        rmdir -- "$dl_tmp" 2>/dev/null
        if command -v termux-media-scan >/dev/null 2>&1; then
            termux-media-scan "$AUDIO_DIR" "$VIDEO_DIR" 2>/dev/null
        fi
        notify_result 'Download complete' "Type: $content_type$playlist_info | Files: $moved | Attempt: $attempt"
    else
        log_error "$url | Type: $content_type$playlist_info | Download failed after 3 attempts | Last exit status: $exit_status | Partial files retained in: $dl_tmp"
        log_error "$url | Suggestion: try a VPN, or export browser cookies and set COOKIE_ARGS."
        notify_result 'Download failed' "3 attempts exhausted | Exit status: $exit_status"
    fi
    if [[ -n $detail_log ]]; then
        printf 'Finished: %s | Success: %s\n' "$(date -Iseconds)" "$download_success" >> "$detail_log"
        finish_error_log
    fi
    if [[ -n $token && ! -e "$STATE_DIR/$token.url" ]]; then
        rm -f -- "$STATE_DIR/$token"
    fi
} &
# Android returns to the previous app automatically
exit 0
