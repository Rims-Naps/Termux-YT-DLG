#!/bin/bash

# Define single directory for all downloads
DOWNLOAD_DIR="/data/data/com.termux/files/home/storage/shared/New"
LOG_FILE="/data/data/com.termux/files/home/storage/shared/yt_dlp_log.txt"

# Create directory and log file if they don't exist
[ -d "$DOWNLOAD_DIR" ] || mkdir -p "$DOWNLOAD_DIR"
[ -f "$LOG_FILE" ] || touch "$LOG_FILE"

# Get the URL to download from the first argument
url="$1"

# Log download attempt
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Starting background download: $url" >> "$LOG_FILE"

# Launch the download process in the background and return to previous app
{
    # Initialize variables for logging
    content_type="unknown"
    download_success=false
    file_count=1
    playlist_info=""

    # Force audio format for all music.youtube.com URLs and playlists
    if [[ "$url" == *"music.youtube.com"* ]] || [[ "$url" == *"playlist"* ]] || [[ "$url" == *"list="* ]]; then
      content_type="music"
      format="bestaudio[ext=m4a]/bestaudio/best"
      postprocessor="-x --audio-format mp3 --audio-quality 0"
      # Updated extractor args for current YouTube API
      extractor_args="--extractor-args youtube:player_client=android,web"
    elif [[ "$url" == *"youtube.com/watch"* ]] || [[ "$url" == *"youtu.be"* ]]; then
      content_type="video"
      format="bestvideo[height<=1080][ext=mp4]+bestaudio[ext=m4a]/best[height<=1080][ext=mp4]/best"
      postprocessor=""
      extractor_args="--extractor-args youtube:player_client=android,web"
    else
      content_type="unknown"
      format="best"
      postprocessor=""
      extractor_args=""
    fi

    # For playlists, force audio format regardless of URL changes
    if [[ "$url" == *"playlist"* || "$url" == *"list="* ]]; then
      content_type="music"
      playlist_info=" (Playlist)"
      format="bestaudio[ext=m4a]/bestaudio/best"
      postprocessor="-x --audio-format mp3 --audio-quality 0"
      extractor_args="--extractor-args youtube:player_client=android,web --yes-playlist"
    fi

    echo "[$(date +'%Y-%m-%d %H:%M:%S')] Processing: $url | Type: $content_type$playlist_info" >> "$LOG_FILE"

    # Attempt download up to 3 times in case of failure
    for attempt in {1..3}; do
      if yt-dlp $extractor_args -f "$format" $postprocessor --no-warnings --ignore-errors -o "$DOWNLOAD_DIR/%(title)s.%(ext)s" "$url" 2>> "$LOG_FILE"; then
        download_success=true
        
        # Get actual number of downloaded files (for playlists)
        if [[ "$url" == *"playlist"* || "$url" == *"list="* ]]; then
          file_count=$(find "$DOWNLOAD_DIR" -name "*.mp3" -o -name "*.mp4" -o -name "*.m4a" | wc -l)
        else
          file_count=1
        fi
        
        echo "[$(date +'%Y-%m-%d %H:%M:%S')] Download succeeded! | Files: $file_count" >> "$LOG_FILE"
        break
      else
        echo "[$(date +'%Y-%m-%d %H:%M:%S')] Download failed, attempt $attempt of 3." >> "$LOG_FILE"
        sleep 5
      fi
    done

    # Final log entry for this download
    if [ "$download_success" = false ]; then
      echo "[$(date +'%Y-%m-%d %H:%M:%S')] Download failed after 3 attempts" >> "$LOG_FILE"
    fi

    # Confirm download and scan media if Termux:API is installed
    if command -v termux-media-scan >/dev/null 2>&1; then
      echo "Scanning downloaded media..."
      termux-media-scan "$DOWNLOAD_DIR" 2>/dev/null
      echo "[$(date +'%Y-%m-%d %H:%M:%S')] Media scan completed" >> "$LOG_FILE"
    fi
} &

# Return to previous application immediately - Fixed version
sleep 0.5
if command -v am >/dev/null 2>&1; then
    # Try to return to the previous app
    CURRENT_APP=$(dumpsys window | grep -E 'mCurrentFocus|mFocusedApp' | head -1 | sed 's/.*{[^}]* \([^}]*\)}.*/\1/' | cut -d'/' -f1)
    if [ ! -z "$CURRENT_APP" ] && [ "$CURRENT_APP" != "com.termux" ]; then
        am start -n "$CURRENT_APP" >/dev/null 2>&1
    else
        # Fallback: return to home screen
        am start -a android.intent.action.MAIN -c android.intent.category.HOME >/dev/null 2>&1
    fi
fi

exit 0
