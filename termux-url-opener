#!/bin/bash    
    
# Define directories    
MUSIC_DIR="/data/data/com.termux/files/home/storage/shared/Music"    
YOUTUBE_DIR="/data/data/com.termux/files/home/storage/shared/YouTube"    
UNKNOWN_DIR="/data/data/com.termux/files/home/storage/shared/Unknown"    
LOG_DIR="/data/data/com.termux/files/home/storage/shared/Download"    
LOG_FILE="$LOG_DIR/termux_download_log.txt"    
    
# Create directories if they don't exist    
mkdir -p "$MUSIC_DIR" "$YOUTUBE_DIR" "$UNKNOWN_DIR" "$LOG_DIR"    
    
# Create log file if it doesn't exist    
[ -f "$LOG_FILE" ] || touch "$LOG_FILE"    
    
# Get the URL to download from the first argument    
url="$1"    
    
# Initialize variables for logging    
content_type="unknown"    
download_success=false    
file_count=1    
playlist_info=""    
    
# Determine content type based on URL and set quality and output directory    
if [[ "$url" == *"music.youtube.com"* ]]; then    
  content_type="music"    
  output_dir="$MUSIC_DIR/%(title)s.%(ext)s"    
  # Force m4a format for both single tracks and playlists    
  format="bestaudio[ext=m4a]"    
  postprocessor="--audio-format mp3 --audio-quality 0"    
elif [[ "$url" == *"youtube.com/watch"* ]] || [[ "$url" == *"youtu.be"* ]]; then    
  content_type="video"    
  output_dir="$YOUTUBE_DIR/%(title)s.%(ext)s"    
  format="bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best"    
  postprocessor=""    
else    
  content_type="unknown"    
  output_dir="$UNKNOWN_DIR/%(title)s.%(ext)s"    
  format="best"    
  postprocessor=""    
fi    
    
# Check if URL is a playlist    
if [[ "$url" == *"playlist"* || "$url" == *"list="* ]]; then    
  playlist_info=" (Playlist)"    
  # For playlists, ensure we're getting audio in consistent format    
  if [[ "$content_type" == "music" ]]; then    
    format="bestaudio[ext=m4a]"    
    postprocessor="--audio-format mp3 --audio-quality 0"    
  fi    
fi    
    
# Log download attempt    
echo "[$(date +'%Y-%m-%d %H:%M:%S')] Starting download: $url | Type: $content_type$playlist_info" >> "$LOG_FILE"    
    
# Attempt download up to 3 times in case of failure    
for attempt in {1..3}; do    
  if yt-dlp -f "$format" $postprocessor -o "$output_dir" "$url"; then    
    download_success=true    
        
    # Get actual number of downloaded files (for playlists)    
    file_count=$(yt-dlp --flat-playlist --print "%(n_entries)s" "$url" 2>/dev/null)    
    [ -z "$file_count" ] && file_count=1    
        
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] Download succeeded! | Files: $file_count" >> "$LOG_FILE"    
    break    
  else    
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] Download failed, attempt $attempt of 3." >> "$LOG_FILE"    
    sleep 5    
  fi    
done    
    
# Final log entry for this download    
if [ "$download_success" = false ]; then    
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] Download failed after 3 attempts" >> "$LOG_FILE"    
fi    
    
# Confirm download and scan media if Termux:API is installed    
if command -v termux-media-scan >/dev/null; then    
  echo "Scanning downloaded media..."    
  termux-media-scan "$YOUTUBE_DIR" "$MUSIC_DIR" "$UNKNOWN_DIR"    
  echo "[$(date +'%Y-%m-%d %H:%M:%S')] Media scan completed" >> "$LOG_FILE"    
fi    
